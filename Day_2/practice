//5)Calculate Total Salary using reduce()
function tsal(a){
  return a.reduce((p,c)=>{return p+c.salary;},0)
}
let size=Number(prompt())
let arr=[]
for(let i=0;i<size;i++){
  let name=prompt()
  let salary=Number(prompt())
  arr.push({name:name,salary:salary})
}
let total_salary=tsal(arr)
console.log(total_salary)



//6)Product Sorting – Low → High / High → Low
function arrange(a){
  let ip=prompt(`Enter "asc" for Ascending and "desc" for Descending order : `)
  if(ip==="asc"){
    a.sort((c,n)=>c.price-n.price)
  }
  else{
    a.sort((c,n)=>n.price-c.price)
  }
  console.log(a)
}
let size=Number(prompt())
let arr=[]
for(let i=0;i<size;i++){
  let name=prompt()
  let price=Number(prompt())
  arr.push({name:name,price:price})
}
arrange(arr)
