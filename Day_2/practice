//1) Find the Second Largest Number
function seclar(a){
  let l=-Infinity
  let sl=-Infinity
  for(let i of a){
    if(i>l){
      sl=l
      l=i
    }
    else if(i<l && i>sl)sl=i
  }
  return sl
}
let size=Number(prompt())
let arr=[]
for(let i=0;i<size;i++)arr.push(Number(prompt()))
let res=seclar(arr)
console.log(res)



//2)Find Duplicate Values
function dup(a){
  let m=new Map();
  let duplicate=[]
  for(let i of a)m.set(i,(m.get(i)||0)+1)
  for(let i of m.keys()){
    if(m.get(i)>1)duplicate.push(i)
  }
  console.log(`the duplicates are ${duplicate}`)
}
let size=Number(prompt())
let arr=[]
for(let i=0;i<size;i++)arr.push(Number(prompt()))
dup(arr)



